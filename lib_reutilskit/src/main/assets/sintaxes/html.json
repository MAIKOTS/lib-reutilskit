{
  "nome": "HTML",
  "extensoes": ["html", "htm"],
  "regras": [
    { "nome": "Comentário", "regex": "<!--[\\s\\S]*?-->", "cor": "#6A9955" },
    { "nome": "Tag", "regex": "(<[a-zA-Z0-9]+|</[a-zA-Z0-9]+>|/?>)", "cor": "#569CD6" },
    { "nome": "Atributo", "regex": "\\b[a-zA-Z-]+=", "cor": "#4EC9B0" },
    { "nome": "String", "regex": "\"([^\"]*)\"|'([^']*)'", "cor": "#CE9178" }
  ]
}