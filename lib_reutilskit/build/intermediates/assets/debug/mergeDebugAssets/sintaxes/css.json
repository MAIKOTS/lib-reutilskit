{
  "nome": "CSS",
  "extensoes": ["css", "scss", "sass"],
  "regras": [
    { "nome": "Comentário", "regex": "/\\*[\\s\\S]*?\\*/", "cor": "#6A9955" },
    { "nome": "Seletor", "regex": "([.#]?[a-zA-Z0-9_-]+)(?=\\s*\\{)", "cor": "#569CD6" },
    { "nome": "Propriedade", "regex": "\\b([a-zA-Z-]+)(?=\\s*:)", "cor": "#4EC9B0" },
    { "nome": "Valor/Cor", "regex": "#[0-9a-fA-F]{3,8}\\b|\\b\\d+(px|em|rem|%|vh|vw)?\\b", "cor": "#B5CEA8" }
  ]
}